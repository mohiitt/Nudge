# Copy to .env and fill values. See docs/CREDENTIALS.md for step-by-step setup.
# Local mocked demos work with MOCK_MODE=true and no live secrets.

# --- App ---
MOCK_MODE=true
DEFAULT_CSM_ID=csm_demo_001
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- SingleStore Helios ---
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=nudge

# --- SIE (Superlinked Serverless) ---
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
SIE_CLASSIFY_MODEL=knowledgator/gliclass-large-v3.0
SIE_EXTRACT_MODEL=fastino/gliner2-large-v1
SIE_REDACT_MODEL=numind/NuNER_Zero

# --- Amplitude ---
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_API_URL=https://api2.amplitude.com/2/httpapi

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com

# --- Gmail / email drafts (never send real external email) ---
GMAIL_BASE_URL=https://gmail.googleapis.com

# --- Slack (optional) ---
SLACK_BOT_TOKEN=
SLACK_BASE_URL=https://slack.com/api

# --- Kaggle (RavenStack) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Local Postgres (docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nudge
POSTGRES_PASSWORD=nudge
POSTGRES_DB=nudge_support

# --- Airbyte OSS (abctl local credentials) ---
AIRBYTE_URL=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
